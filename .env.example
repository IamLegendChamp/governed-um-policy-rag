# Azure AI Foundry / Azure OpenAI-compatible
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# NOTE: chat deployment currently unused for generation -- Azure Free Trial blocks chat-model quota entirely;
# generation runs via Cohere/OpenAI instead (see --backend flag). Kept here for the planned judge-CI phase.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4o-mini
JUDGE_GROUNDEDNESS_MIN=0.8

# Pinecone
PINECONE_API_KEY=replace-me
PINECONE_INDEX_NAME=governed-um-policy-rag
# PINECONE_HOST=https://your-index-xxxx.svc.pinecone.io

# Cohere (rerank + optional chat generation backend, --backend cohere)
COHERE_API_KEY=replace-me
COHERE_RERANK_MODEL=rerank-v3.5

# OpenAI direct (platform.openai.com, NOT Azure) -- default chat generation backend, --backend openai
OPENAI_API_KEY=replace-me

LOG_LEVEL=INFO
