# Azure AI Foundry / Azure OpenAI-style (Phase 2+)
# Create deployments in AI Foundry, then paste endpoint + keys here.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# Phase 6 — LLM-as-a-Judge (can be same or separate deployment)
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4o-mini
JUDGE_GROUNDEDNESS_MIN=0.8

# Pinecone (Phase 2a+)
PINECONE_API_KEY=replace-me
PINECONE_INDEX_NAME=agentforge-p01-um-policy
# Serverless: set in Pinecone console; optional override:
# PINECONE_HOST=https://your-index-xxxx.svc.pinecone.io

LOG_LEVEL=INFO
